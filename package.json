{
  "name": "@radardou/sdk",
  "version": "1.0.0",
  "description": "SDK oficial para a API do Radar DOU - Monitoramento do Diário Oficial da União",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dou",
    "diario-oficial",
    "brasil",
    "governo",
    "api",
    "sdk",
    "radar-dou",
    "monitoramento",
    "licitacao",
    "publicacao"
  ],
  "author": "Radar DOU <suporte@radar-dou.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/radar-dou/radardou-js"
  },
  "homepage": "https://radar-dou.com",
  "bugs": {
    "url": "https://github.com/radar-dou/radardou-js/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
